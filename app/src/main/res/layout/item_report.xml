<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="12dp">

    <!-- Nombre -->
    <TextView
        android:id="@+id/txtItemReportName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="@string/label_report_name"
        android:textColor="@android:color/darker_gray"
        android:textStyle="bold"
        android:textSize="18sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btnOptions"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Fecha creación -->
    <TextView
        android:id="@+id/txtItemReportCreatedAt"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text=""
        android:textColor="@android:color/darker_gray"
        android:textSize="13sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btnOptions"
        app:layout_constraintTop_toBottomOf="@id/txtItemReportName" />

    <!-- Empresa -->
    <TextView
        android:id="@+id/txtItemReportCompanyLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/label_company"
        android:textColor="@color/title_blue_800"
        android:textSize="16sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtItemReportCreatedAt"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/txtItemReportCompanyValue"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="16sp"
        android:textColor="@android:color/black"
        android:maxLines="1"
        android:ellipsize="end"
        app:layout_constraintStart_toEndOf="@id/txtItemReportCompanyLabel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/txtItemReportCompanyLabel"
        android:layout_marginStart="8dp" />


    <!-- Periodo -->
    <TextView

        android:id="@+id/txtItemReportPeriodLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/label_period"
        android:textColor="@color/title_blue_800"
        android:textSize="16sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtItemReportCompanyLabel"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/txtItemReportPeriodValue"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text=""
        android:textColor="@android:color/black"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/txtItemReportPeriodLabel"
        app:layout_constraintTop_toTopOf="@id/txtItemReportPeriodLabel" />


    <!-- Icono lista -->
    <ImageView
        android:id="@+id/btnOptions"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginStart="8dp"
        android:padding="4dp"
        android:src="@drawable/ic_lista"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:tint="@color/title_blue_800" />

    <!-- Línea separadora -->
    <View
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="@color/title_blue_800"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/txtItemReportPeriodLabel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>