<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

<androidx.constraintlayout.widget.ConstraintLayout
    android:id="@+id/register"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="24dp"
    tools:context=".activities.RegisterActivity">

    <TextView
        android:id="@+id/txtTitleAppRegister"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/app_title"
        android:textColor="@color/title_blue_800"
        android:textSize="26sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.497"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/imgLogoRegister" />

    <ImageView
        android:id="@+id/imgLogoRegister"
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:layout_marginTop="40dp"
        android:contentDescription="@string/logo"
        android:src="@drawable/ic_logo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.498"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <TextView
        android:id="@+id/txtRegister"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/title_register"
        android:textColor="@color/title_blue_800"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.498"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtTitleAppRegister" />

    <TextView
        android:id="@+id/txtNameRegister"
        android:layout_marginHorizontal="16dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/label_name"
        android:textColor="@color/title_blue_800"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="@id/etNameRegister"
        app:layout_constraintStart_toStartOf="@id/etNameRegister"
        app:layout_constraintTop_toBottomOf="@id/txtRegister" />


    <EditText
        android:id="@+id/etNameRegister"
        android:layout_marginHorizontal="16dp"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:backgroundTint="#BDBDBD"
        android:hint="@string/label_name"
        android:inputType="textPersonName"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtNameRegister" />


    <TextView
        android:id="@+id/txtEmailRegister"
        android:layout_marginHorizontal="16dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/label_email"
        android:textColor="@color/title_blue_800"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="@id/etEmailRegister"
        app:layout_constraintStart_toStartOf="@id/etEmailRegister"
        app:layout_constraintTop_toBottomOf="@id/etNameRegister" />

    <EditText
        android:id="@+id/etEmailRegister"
        android:layout_marginHorizontal="16dp"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:backgroundTint="#BDBDBD"
        android:hint="@string/label_email"
        android:inputType="textEmailAddress"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtEmailRegister" />


    <TextView
        android:id="@+id/txtPasswordRegister"
        android:layout_marginHorizontal="16dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/label_password"
        android:textColor="@color/title_blue_800"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="@id/etPasswordRegister"
        app:layout_constraintStart_toStartOf="@id/etPasswordRegister"
        app:layout_constraintTop_toBottomOf="@id/etEmailRegister" />


    <EditText
        android:id="@+id/etPasswordRegister"
        android:layout_marginHorizontal="16dp"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:backgroundTint="#BDBDBD"
        android:hint="@string/label_password"
        android:inputType="textPassword"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtPasswordRegister" />


    <TextView
        android:id="@+id/txtConfirmPassword"
        android:layout_marginHorizontal="16dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/label_confirm_passw"
        android:textColor="@color/title_blue_800"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="@id/etConfirmPassword"
        app:layout_constraintStart_toStartOf="@id/etConfirmPassword"
        app:layout_constraintTop_toBottomOf="@id/etPasswordRegister" />

    <EditText
        android:id="@+id/etConfirmPassword"
        android:layout_marginHorizontal="16dp"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:backgroundTint="#BDBDBD"
        android:hint="@string/label_confirm_passw"
        android:inputType="textPassword"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtConfirmPassword" />



    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCreateAccount"
        android:layout_marginHorizontal="16dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:backgroundTint="@color/button_blue"
        android:text="@string/action_create_acount"
        android:textColor="@color/text_button_white"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/etConfirmPassword" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnReturnLogin"
        android:layout_marginHorizontal="16dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:backgroundTint="@color/button_blue"
        android:text="@string/action_back_to_login"
        android:textColor="@color/text_button_white"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnCreateAccount" />


</androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>