<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"

    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="12dp">

    <!-- Fecha -->
    <TextView
        android:id="@+id/txtDateConfirmList"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Fecha"
        android:textColor="@color/title_blue_800"
        android:textSize="16sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/txtDateConfirmListLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="16sp"
        android:textColor="@android:color/black"
        android:maxLines="1"
        android:ellipsize="end"
        app:layout_constraintStart_toEndOf="@id/txtDateConfirmList"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/txtDateConfirmList"
        android:layout_marginStart="8dp" />

    <!-- Empresa -->
    <TextView
        android:id="@+id/txtCompanyConfirmList"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Empresa"
        android:textColor="@color/title_blue_800"
        android:textSize="16sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtDateConfirmList"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/txtCompanyConfirmListLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="16sp"
        android:textColor="@android:color/black"
        android:maxLines="1"
        android:ellipsize="end"
        app:layout_constraintStart_toEndOf="@id/txtCompanyConfirmList"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/txtCompanyConfirmList"
        android:layout_marginStart="8dp" />

    <!-- Concepto -->
    <TextView
        android:id="@+id/txtConceptConfirmList"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Concepto"
        android:textColor="@color/title_blue_800"
        android:textSize="16sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtCompanyConfirmList"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/txtConceptConfirmListLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="16sp"
        android:textColor="@android:color/black"
        android:maxLines="1"
        android:ellipsize="end"
        app:layout_constraintStart_toEndOf="@id/txtConceptConfirmList"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/txtConceptConfirmList"
        android:layout_marginStart="8dp" />

    <!-- Cantidad -->
    <TextView
        android:id="@+id/txtQuantityConfirmList"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Cantidad"
        android:textColor="@color/title_blue_800"
        android:textSize="16sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtConceptConfirmList"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/txtQuantityConfirmListLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="16sp"
        android:textColor="@android:color/black"
        android:maxLines="1"
        android:ellipsize="end"
        app:layout_constraintStart_toEndOf="@id/txtQuantityConfirmList"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/txtQuantityConfirmList"
        android:layout_marginStart="8dp" />

    <!-- Comentarios -->
    <TextView
        android:id="@+id/txtCommentConfirmList"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Comentarios"
        android:textColor="@color/title_blue_800"
        android:textSize="16sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtQuantityConfirmList"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/txtCommentConfirmListLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="16sp"
        android:textColor="@android:color/black"
        android:maxLines="1"
        android:ellipsize="end"
        app:layout_constraintStart_toEndOf="@id/txtCommentConfirmList"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/txtCommentConfirmList"
        android:layout_marginStart="8dp" />



    <!-- Icono editar -->
    <ImageView
        android:id="@+id/btnEdit"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginStart="8dp"
        android:padding="4dp"
        android:src="@drawable/ic_edit"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:tint="@color/title_blue_800" />

    <!-- Línea separadora -->
    <View
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="@color/title_blue_800"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/txtCommentConfirmListLabel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>